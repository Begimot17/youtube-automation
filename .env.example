# Copy to .env and fill in. Never commit .env.

# --- Content generation ---
GOOGLE_API_KEY=            # or GEMINI_API_KEY
GEMINI_MODEL_ID=gemini-2.5-flash-lite
PEXELS_API_KEY=
ASSEMBLYAI_API_KEY=        # word-level subtitles

# --- gen_v2 (RunPod) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# --- Telegram bot / notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Control API ---
PORT=5000
# Base URL the bot uses to reach the API (in docker-compose: http://server:5000)
API_BASE_URL=http://localhost:5000
# Optional shared secret. When set, every endpoint except /health requires
# header "X-API-Token: <value>" (or "Authorization: Bearer <value>"); the bot sends it automatically.
API_TOKEN=

# --- Database ---
DB_TYPE=mysql              # mysql | sqlite
# DATABASE_URL=mysql+mysqlconnector://user:user_password@localhost:3307/automation

# --- Behaviour ---
TIKTOK_DOWNLOAD_COUNT=2
DEBUG=false
PLAYWRIGHT_SLOW_MO=0

# Optional per-account YouTube passwords used when a channel has none stored:
# YT_PASSWORD_<ACCOUNT_NAME_UPPERCASE>=
